# Настройки для коллег. Скопируйте в .env и впишите СВОЙ токен Jira.
# Адрес Jira, ключ проекта и запросы вам перешлют внутри команды (в публичный репозиторий они не попадают).
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
# свой токен: https://id.atlassian.com/manage-profile/security/api-tokens (чужой токен не используйте)
JIRA_API_TOKEN=
# JIRA_JQL=
# JIRA_SPRINT_JQL=
DEFAULT_CAPACITY_HOURS=50
SUPPORT_PERCENT=15
