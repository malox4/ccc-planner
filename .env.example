# Скопируйте в .env и заполните. Файл .env не коммитить.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
# ключ вашего Jira-проекта; из него строятся запросы по умолчанию
JIRA_PROJECT_KEY=DEMO
# API-токен создаётся на https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Что считается «доской»: всё незакрытое + всё из открытого спринта
# JIRA_JQL=project = DEMO AND (statusCategory != Done OR sprint in openSprints()) ORDER BY key DESC
# JIRA_SPRINT_JQL=project = DEMO AND sprint in openSprints()

DEFAULT_CAPACITY_HOURS=50
# сопровождение аналитика по задачам в работе, % от часов разработки
SUPPORT_PERCENT=15
